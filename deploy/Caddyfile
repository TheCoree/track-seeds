# HTTPS для сайта дробилок из интернета. Включается сам (deploy/setup.sh), если в .env задан DOMAIN.
# Сертификат Let's Encrypt Caddy получает и продлевает сам. Нужны: A-запись домена на внешний IP
# и проброс портов 80 и 443 роутера на этот сервер. Порт 8080 наружу не пробрасывать.
# Caddy — из Debian (2.6), в образе track-seeds: здесь только то, что он умеет.
{
	# управление Caddy по HTTP не нужно: настройки меняются перезапуском контейнера
	admin off
}

{$DOMAIN} {
	# запрос больше этого сюда не пройдёт: самое большое законное — эталон до 20 МБ
	request_body {
		max_size 25MB
	}
	# страницы и данные — сжатыми; видео (multipart) Caddy не сжимает и отдаёт без задержки
	encode zstd gzip
	# сайт видит Caddy на 127.0.0.1 (WEB_TRUSTED_PROXIES) и берёт адрес посетителя из X-Forwarded-For
	reverse_proxy 127.0.0.1:{$WEB_PORT:8080}
	header -Server
}
